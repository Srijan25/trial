<div class="dashboard">

  <!-- ================= HEADER ================= -->

  <div class="page-header">

    <div class="header-left">
      <h1>Transaction Monitor</h1>
      <p>Monitor grouped transactions and processing status</p>
    </div>

    <div class="header-right">

      <button
        class="refresh-btn"
        type="button"
        (click)="refresh()">

        ↻ &nbsp; Refresh

      </button>

    </div>

  </div>


  <!-- ================= SUMMARY ================= -->

  <div class="summary-grid">

    <!-- Groups -->

    <div class="summary-card">

      <div class="summary-top">

        <span class="summary-label">
          Total Groups
        </span>

        <div class="summary-icon">
          ▦
        </div>

      </div>

      <div class="summary-value">
        {{ totalGroups }}
      </div>

    </div>


    <!-- Transactions -->

    <div class="summary-card">

      <div class="summary-top">

        <span class="summary-label">
          Transactions
        </span>

        <div class="summary-icon">
          ⇄
        </div>

      </div>

      <div class="summary-value">
        {{ totalTransactions }}
      </div>

    </div>


    <!-- Success -->

    <div class="summary-card success">

      <div class="summary-top">

        <span class="summary-label">
          Successful
        </span>

        <div class="summary-icon">
          ✓
        </div>

      </div>

      <div class="summary-value">
        {{ totalSuccess }}
      </div>

    </div>


    <!-- Errors -->

    <div class="summary-card error">

      <div class="summary-top">

        <span class="summary-label">
          Errors
        </span>

        <div class="summary-icon">
          !
        </div>

      </div>

      <div class="summary-value">
        {{ totalErrors }}
      </div>

    </div>

  </div>


  <!-- ================= SEARCH / FILTER ================= -->

  <div class="toolbar">

    <div class="search-wrapper">

      <span class="search-icon">
        ⌕
      </span>

      <input
        class="search-input"
        type="text"
        placeholder="Search group ID, transaction ID, event or external number..."
        [(ngModel)]="searchText"
        (input)="search()">

    </div>


    <select
      class="filter-select"
      [(ngModel)]="statusFilter"
      (change)="changeFilter()">

      <option value="ALL">
        All Groups
      </option>

      <option value="SUCCESS">
        No Errors
      </option>

      <option value="ERROR">
        Has Errors
      </option>

    </select>

  </div>


  <!-- ================= LOADING ================= -->

  <div
    class="loading-container"
    *ngIf="loading">

    <div class="loading-spinner"></div>

  </div>


  <!-- ================= GROUP LIST ================= -->

  <div
    class="groups-container"
    *ngIf="!loading">


    <!-- ================= GROUP CARD ================= -->

    <div
      class="group-card"
      *ngFor="let group of filteredGroups"
      [class.expanded]="selectedGroup?.groupId === group.groupId">


      <!-- ================= GROUP HEADER ================= -->

      <div
        class="group-header"
        (click)="toggleGroup(group)">


        <!-- GROUP ID -->

        <div class="group-info">

          <button
            class="expand-button"
            type="button"
            (click)="$event.stopPropagation(); toggleGroup(group)">

            <span *ngIf="selectedGroup?.groupId !== group.groupId">
              ▶
            </span>

            <span *ngIf="selectedGroup?.groupId === group.groupId">
              ▼
            </span>

          </button>


          <div class="group-id-block">

            <span class="group-label">
              Group ID
            </span>

            <span class="group-id">
              {{ group.groupId }}
            </span>

          </div>

        </div>


        <!-- ================= LATEST TRANSACTION ================= -->

        <div class="last-transaction">

          <span class="transaction-event">

            {{ group.latestTransaction.f_EVENT }}

          </span>


          <div class="transaction-main">

            <div class="transaction-id">

              Transaction ID
              {{ group.latestTransaction.f_ID }}

            </div>


            <div class="transaction-meta">

              <span>
                ORIG ID:
                {{ group.latestTransaction.f_ORIG_ID }}
              </span>

              <span>
                {{ group.latestTransaction.f_DEAL_TYPE }}
              </span>

              <span>
                {{ group.latestTransaction.f_REQUEST_TIME }}
              </span>

            </div>

          </div>

        </div>


        <!-- ================= GROUP STATUS ================= -->

        <div class="group-status">

          <span class="transaction-count">

            {{ group.transactionCount }}

            <span *ngIf="group.transactionCount === 1">
              Transaction
            </span>

            <span *ngIf="group.transactionCount !== 1">
              Transactions
            </span>

          </span>


          <span
            class="error-count"
            [class.no-error]="group.errorCount === 0">

            <span *ngIf="group.errorCount > 0">
              {{ group.errorCount }} Error
              <span *ngIf="group.errorCount !== 1">
                s
              </span>
            </span>

            <span *ngIf="group.errorCount === 0">
              No Errors
            </span>

          </span>

        </div>

      </div>


      <!-- ================= EXPANDED GROUP ================= -->

      <div
        class="group-details"
        *ngIf="selectedGroup?.groupId === group.groupId">


        <!-- TABLE HEADER -->

        <div class="details-header">

          <div>
            Event
          </div>

          <div>
            ID
          </div>

          <div>
            Status
          </div>

          <div>
            External No.
          </div>

          <div>
            ORIG ID
          </div>

          <div>
            Deal Type
          </div>

          <div>
            Open
          </div>

        </div>


        <!-- ================= TRANSACTIONS ================= -->

        <div
          class="transaction-row"
          *ngFor="let transaction of group.transactions"
          [class.error-row]="isError(transaction)"
          (click)="openTransaction(transaction)">


          <!-- EVENT -->

          <div class="row-event">

            {{ transaction.f_EVENT }}

          </div>


          <!-- ID -->

          <div class="row-id">

            {{ transaction.f_ID }}

          </div>


          <!-- STATUS -->

          <div>

            <span
              class="row-status"
              [class.error]="isError(transaction)">

              {{ getStatus(transaction) }}

            </span>

          </div>


          <!-- EXTERNAL NUMBER -->

          <div
            class="row-value"
            [title]="transaction.f_EXT_NO">

            {{ transaction.f_EXT_NO }}

          </div>


          <!-- ORIG ID -->

          <div class="row-value">

            {{ transaction.f_ORIG_ID }}

          </div>


          <!-- DEAL TYPE -->

          <div class="row-value">

            {{ transaction.f_DEAL_TYPE }}

          </div>


          <!-- ARROW -->

          <div class="row-arrow">

            →

          </div>


          <!-- ERROR MESSAGE -->

          <div
            class="error-message"
            *ngIf="isError(transaction)">

            <strong>
              Error:
            </strong>

            {{ transaction.f_ERROR || 'Transaction processing failed' }}

          </div>

        </div>


      </div>

    </div>


  </div>


  <!-- ================= EMPTY STATE ================= -->

  <div
    class="empty-state"
    *ngIf="!loading && filteredGroups.length === 0">

    <div class="empty-state-icon">
      ⌕
    </div>

    <h3>
      No transactions found
    </h3>

    <p>
      Try changing your search or filter.
    </p>

  </div>


  <!-- ================================================= -->
  <!-- TRANSACTION DETAIL - THIRD LEVEL                  -->
  <!-- ================================================= -->

  <div
    class="detail-panel"
    *ngIf="selectedTransaction">


    <!-- ================= DETAIL HEADER ================= -->

    <div class="detail-header">

      <div class="detail-title">

        <div>

          <h2>
            Transaction Details
          </h2>

          <p>
            Transaction ID:
            {{ selectedTransaction.f_ID }}

            &nbsp; • &nbsp;

            Group:
            {{ selectedTransaction.f_GROUP_ID }}

          </p>

        </div>

      </div>


      <button
        class="close-button"
        type="button"
        (click)="closeTransaction()">

        ✕

      </button>

    </div>


    <!-- ================= DETAIL DATA ================= -->

    <div class="detail-grid">


      <!-- EVENT -->

      <div class="detail-item">

        <span class="detail-label">
          Event
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_EVENT }}
        </span>

      </div>


      <!-- TRANSACTION ID -->

      <div class="detail-item">

        <span class="detail-label">
          Transaction ID
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_ID }}
        </span>

      </div>


      <!-- GROUP ID -->

      <div class="detail-item">

        <span class="detail-label">
          Group ID
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_GROUP_ID }}
        </span>

      </div>


      <!-- ORIG ID -->

      <div class="detail-item">

        <span class="detail-label">
          Original ID
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_ORIG_ID }}
        </span>

      </div>


      <!-- DEAL TYPE -->

      <div class="detail-item">

        <span class="detail-label">
          Deal Type
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_DEAL_TYPE }}
        </span>

      </div>


      <!-- SOURCE -->

      <div class="detail-item">

        <span class="detail-label">
          Source System
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_SRC_SYSTEM }}
        </span>

      </div>


      <!-- REQUEST TIME -->

      <div class="detail-item">

        <span class="detail-label">
          Request Time
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_REQUEST_TIME }}
        </span>

      </div>


      <!-- EXTERNAL NUMBER -->

      <div class="detail-item">

        <span class="detail-label">
          External Number
        </span>

        <span class="detail-value">
          {{ selectedTransaction.f_EXT_NO }}
        </span>

      </div>


      <!-- STATUS -->

      <div class="detail-item">

        <span class="detail-label">
          Status
        </span>


        <span
          class="status-success"
          *ngIf="!isError(selectedTransaction)">

          ✓ SUCCESS

        </span>


        <span
          class="status-error"
          *ngIf="isError(selectedTransaction)">

          ! ERROR

        </span>

      </div>


      <!-- ERROR -->

      <div
        class="detail-item"
        *ngIf="selectedTransaction.f_ERROR">

        <span class="detail-label">
          Error Message
        </span>

        <span class="detail-value">

          {{ selectedTransaction.f_ERROR }}

        </span>

      </div>


      <!-- MX RESPONSE -->

      <div
        class="detail-item"
        *ngIf="selectedTransaction.f_MX_RESPONSE">

        <span class="detail-label">
          MX Response
        </span>

        <span class="detail-value">

          {{ selectedTransaction.f_MX_RESPONSE }}

        </span>

      </div>


    </div>


    <!-- ================= FUTURE API NOTE ================= -->

    <div
      class="error-message"
      *ngIf="isError(selectedTransaction)"
      style="margin-top: 20px;">

      <strong>
        Processing Error:
      </strong>

      {{ selectedTransaction.f_ERROR }}

    </div>


  </div>

</div>
