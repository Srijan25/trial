/* ================================
   TRANSACTION DETAIL POPUP
   ================================ */

.transaction-detail-overlay {
  position: fixed;
  inset: 0;

  width: 100vw;
  height: 100vh;

  background: rgba(15, 23, 42, 0.60);

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 30px;

  box-sizing: border-box;

  z-index: 99999;
}

.transaction-detail-window {
  width: 900px;
  max-width: 95vw;
  max-height: 90vh;

  background: #ffffff;

  border-radius: 20px;

  overflow-y: auto;
  overflow-x: hidden;

  box-shadow:
    0 30px 80px rgba(15, 23, 42, 0.35);

  position: relative;

  padding: 0;

  animation: detailPopup 0.2s ease-out;
}

@keyframes detailPopup {
  from {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}


/* ================================
   HEADER
   ================================ */

.transaction-detail-window .detail-header {
  display: flex;

  justify-content: space-between;
  align-items: flex-start;

  padding: 28px 32px 22px;

  border-bottom: 1px solid #e5e7eb;

  background: #ffffff;
}

.transaction-detail-window .detail-title {
  flex: 1;
}

.transaction-detail-window .detail-title h2 {
  margin: 0;

  font-size: 25px;
  font-weight: 700;

  color: #0f172a;
}

.transaction-detail-window .detail-title p {
  margin: 8px 0 0;

  font-size: 13px;

  color: #64748b;
}

.transaction-detail-window .detail-title strong {
  color: #334155;
}


/* ================================
   CLOSE BUTTON
   ================================ */

.close-detail-btn {
  width: 38px;
  height: 38px;

  flex-shrink: 0;

  border: none;

  border-radius: 10px;

  background: #f1f5f9;

  color: #475569;

  font-size: 25px;
  line-height: 1;

  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;

  transition: 0.2s;
}

.close-detail-btn:hover {
  background: #e2e8f0;
  color: #0f172a;
}


/* ================================
   STATUS AREA
   ================================ */

.transaction-detail-window .detail-status {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 20px 32px 5px;
}

.transaction-detail-window .status-badge {
  display: inline-flex;

  align-items: center;

  padding: 7px 14px;

  border-radius: 20px;

  font-size: 12px;
  font-weight: 700;
}

.transaction-detail-window .status-success {
  background: #dcfce7;
  color: #15803d;
}

.transaction-detail-window .status-error {
  background: #fee2e2;
  color: #dc2626;
}

.transaction-detail-window .detail-event {
  font-size: 13px;
  font-weight: 600;

  color: #475569;

  padding: 6px 12px;

  background: #f1f5f9;

  border-radius: 8px;
}


/* ================================
   CONTENT
   ================================ */

.transaction-detail-window .details-content {
  padding: 10px 32px 30px;
}


/* ================================
   SECTION TITLE
   ================================ */

.transaction-detail-window .detail-section-title {
  margin: 25px 0 12px;

  font-size: 15px;
  font-weight: 700;

  color: #1e293b;
}


/* ================================
   DETAIL GRID
   ================================ */

.transaction-detail-window .detail-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 12px;
}


/* ================================
   DETAIL ITEM
   ================================ */

.transaction-detail-window .detail-item {
  min-height: 65px;

  padding: 14px 16px;

  box-sizing: border-box;

  background: #f8fafc;

  border: 1px solid #e2e8f0;

  border-radius: 10px;
}

.transaction-detail-window .detail-item span {
  display: block;

  margin-bottom: 7px;

  font-size: 11px;
  font-weight: 500;

  color: #64748b;
}

.transaction-detail-window .detail-item strong {
  display: block;

  font-size: 14px;
  font-weight: 600;

  color: #0f172a;

  word-break: break-word;
}


/* ================================
   ERROR
   ================================ */

.transaction-detail-window .detail-error {
  margin-top: 20px;

  padding: 15px 18px;

  border-left: 4px solid #ef4444;

  background: #fff1f2;

  border-radius: 8px;
}

.transaction-detail-window .error-title {
  font-size: 13px;
  font-weight: 700;

  color: #dc2626;

  margin-bottom: 5px;
}

.transaction-detail-window .error-text {
  font-size: 13px;

  color: #991b1b;
}


/* ================================
   LOADING
   ================================ */

.transaction-detail-window .detail-loading {
  min-height: 300px;

  display: flex;

  align-items: center;
  justify-content: center;

  color: #64748b;

  font-size: 14px;
}


/* ================================
   FOOTER
   ================================ */

.transaction-detail-window .detail-footer {
  display: flex;

  justify-content: flex-end;

  padding: 18px 32px 25px;

  border-top: 1px solid #e5e7eb;
}

.transaction-detail-window .close-btn {
  border: none;

  background: #0f172a;

  color: #ffffff;

  padding: 10px 24px;

  border-radius: 9px;

  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  transition: 0.2s;
}

.transaction-detail-window .close-btn:hover {
  background: #1e293b;
}


/* ================================
   MOBILE
   ================================ */

@media (max-width: 700px) {

  .transaction-detail-overlay {
    padding: 12px;
  }

  .transaction-detail-window {
    width: 100%;
    max-width: 100%;
    max-height: 94vh;

    border-radius: 16px;
  }

  .transaction-detail-window .detail-header {
    padding: 22px 20px 18px;
  }

  .transaction-detail-window .detail-status {
    padding-left: 20px;
    padding-right: 20px;
  }

  .transaction-detail-window .details-content {
    padding-left: 20px;
    padding-right: 20px;
  }

  .transaction-detail-window .detail-grid {
    grid-template-columns: 1fr;
  }

  .transaction-detail-window .detail-footer {
    padding-left: 20px;
    padding-right: 20px;
  }
}
