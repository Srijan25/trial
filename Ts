openTransaction(transaction: Transaction): void {
  this.selectedTransaction = transaction;
  this.detailLoading = true;

  if (this.useMockData) {
    setTimeout(() => {
      this.selectedTransactionDetails = this.getMockTransactionDetails(transaction);
      this.detailLoading = false;
    }, 500);

    return;
  }

  const url = 'YOUR_SECOND_API_URL/' + transaction.f_ID;

  this.http.get<any>(url).subscribe({
    next: (response) => {
      this.selectedTransactionDetails = response;
      this.detailLoading = false;
    },
    error: (error) => {
      console.error('Transaction detail API error:', error);
      this.selectedTransactionDetails = null;
      this.detailLoading = false;
    }
  });
}

selectedTransactionDetails: any = null;
detailLoading = false;



getMockTransactionDetails(transaction: Transaction): any {
  return {
    transactionId: transaction.f_ID,
    groupId: transaction.f_GROUP_ID,
    event: transaction.f_EVENT,
    status: transaction.f_STATUS,
    dealType: transaction.f_DEAL_TYPE,
    sourceSystem: transaction.f_SRC_SYSTEM,
    originalId: transaction.f_ORIG_ID,
    externalNumber: transaction.f_EXT_NO,
    requestTime: transaction.f_REQUEST_TIME,

    tradeDetails: {
      currencyPair: 'USD/INR',
      buySell: 'BUY',
      amount: 2500000,
      rate: 88.45,
      valueDate: '2026-08-12'
    },

    processingDetails: {
      receivedAt: '2026-08-10 10:15:21',
      processedAt: '2026-08-10 10:15:24',
      processingTime: '3 seconds',
      source: 'BLOTTER',
      destination: 'MUREX'
    },

    responseDetails: {
      mxResponse: transaction.f_MX_RESPONSE || 'SUCCESS',
      error: transaction.f_ERROR || null
    }
  };
}




.detail-section-title {
  margin: 25px 0 12px;
  font-size: 15px;
  color: #334155;
  font-weight: 700;
}

.detail-loading {
  min-height: 250px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  color: #64748b;
  font-size: 14px;
}

.detail-spinner {
  width: 20px;
  height: 20px;
  border: 3px solid #e2e8f0;
  border-top-color: #334155;
  border-radius: 50%;
  animation: detailSpin 0.8s linear infinite;
}

@keyframes detailSpin {
  to {
    transform: rotate(360deg);
  }
}
