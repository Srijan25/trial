/* Group pagination */
.pagination-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin: 18px 0;
  padding: 16px 20px;
  background: #ffffff;
  border: 1px solid #e5eaf1;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
}

.pagination-info {
  color: #64748b;
  font-size: 13px;
}

.pagination-info strong {
  color: #1e293b;
}

.pagination-size {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #475569;
  font-size: 13px;
}

.pagination-size select {
  min-width: 75px;
  padding: 8px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #1e293b;
  cursor: pointer;
  outline: none;
}

.pagination-size select:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.pagination-buttons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
}

.page-btn {
  min-width: 36px;
  height: 36px;
  padding: 0 10px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  color: #475569;
  font-size: 13px;
  cursor: pointer;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}

.page-btn:hover:not(:disabled) {
  background: #eff6ff;
  border-color: #93c5fd;
  color: #1d4ed8;
}

.page-btn.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.page-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

@media (max-width: 700px) {
  .pagination-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .pagination-buttons {
    width: 100%;
  }
}


pageSize = 10;
currentPage = 1;

pageSizeOptions = [10, 20, 50, 100];

get totalPages(): number {
  return Math.max(1, Math.ceil(this.filteredGroups.length / this.pageSize));
}

get paginatedGroups(): GroupData[] {
  const startIndex = (this.currentPage - 1) * this.pageSize;

  return this.filteredGroups.slice(
    startIndex,
    startIndex + this.pageSize
  );
}

get startItem(): number {
  return this.filteredGroups.length === 0
    ? 0
    : (this.currentPage - 1) * this.pageSize + 1;
}

get endItem(): number {
  return Math.min(
    this.currentPage * this.pageSize,
    this.filteredGroups.length
  );
}

get pageNumbers(): number[] {
  return Array.from(
    { length: this.totalPages },
    (_, index) => index + 1
  );
}

changePageSize(size: number | string): void {
  this.pageSize = Number(size);
  this.currentPage = 1;
  this.selectedGroup = null;
  this.selectedTransaction = null;
}

goToPage(page: number): void {
  if (page >= 1 && page <= this.totalPages) {
    this.currentPage = page;
    this.selectedGroup = null;
    this.selectedTransaction = null;
  }
}



<!-- GROUP PAGINATION CONTROLS -->
<div class="pagination-toolbar" *ngIf="filteredGroups.length > 0">

  <div class="pagination-info">
    Showing <strong>{{ startItem }}–{{ endItem }}</strong>
    of <strong>{{ filteredGroups.length }}</strong> groups
  </div>

  <div class="pagination-size">
    <label for="pageSize">Groups per page</label>

    <select
      id="pageSize"
      [ngModel]="pageSize"
      (ngModelChange)="changePageSize($event)">

      <option *ngFor="let size of pageSizeOptions" [ngValue]="size">
        {{ size }}
      </option>
    </select>
  </div>

  <div class="pagination-buttons">
    <button
      type="button"
      class="page-btn"
      [disabled]="currentPage === 1"
      (click)="goToPage(currentPage - 1)">
      Previous
    </button>

    <button
      type="button"
      class="page-btn"
      *ngFor="let page of pageNumbers"
      [class.active]="currentPage === page"
      (click)="goToPage(page)">
      {{ page }}
    </button>

    <button
      type="button"
      class="page-btn"
      [disabled]="currentPage === totalPages"
      (click)="goToPage(currentPage + 1)">
      Next
    </button>
  </div>

</div>


