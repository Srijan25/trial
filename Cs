:host {
  display: block;
  min-height: 100vh;
  background: #f5f7fb;
  color: #172033;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}

/* PAGE */

.dashboard {
  min-height: 100vh;
  padding: 28px 34px;
  box-sizing: border-box;
}

/* HEADER */

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.header-left h1 {
  margin: 0;
  font-size: 26px;
  font-weight: 700;
  color: #172033;
  letter-spacing: -0.4px;
}

.header-left p {
  margin: 6px 0 0;
  color: #7a8497;
  font-size: 13px;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.refresh-btn {
  border: 1px solid #dce2ec;
  background: #ffffff;
  color: #344054;
  height: 40px;
  padding: 0 16px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.refresh-btn:hover {
  border-color: #b8c2d4;
  background: #f8faff;
}

/* SUMMARY CARDS */

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 24px;
}

.summary-card {
  background: #ffffff;
  border: 1px solid #e5e9f1;
  border-radius: 14px;
  padding: 18px 20px;
  box-shadow: 0 3px 12px rgba(31, 45, 61, 0.04);
}

.summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-label {
  font-size: 12px;
  color: #7c8799;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.summary-value {
  margin-top: 9px;
  font-size: 25px;
  font-weight: 700;
  color: #182234;
}

.summary-card.error .summary-value {
  color: #d14343;
}

.summary-card.success .summary-value {
  color: #16855b;
}

.summary-icon {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f4fa;
  color: #50627a;
  font-size: 15px;
}

.summary-card.error .summary-icon {
  background: #fff0f0;
  color: #d14343;
}

.summary-card.success .summary-icon {
  background: #eaf8f2;
  color: #16855b;
}

/* SEARCH BAR */

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 18px;
}

.search-wrapper {
  position: relative;
  flex: 1;
  max-width: 480px;
}

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: #98a2b3;
  font-size: 14px;
}

.search-input {
  width: 100%;
  height: 43px;
  box-sizing: border-box;
  border: 1px solid #dfe4ec;
  border-radius: 9px;
  background: #ffffff;
  padding: 0 14px 0 40px;
  outline: none;
  font-size: 13px;
  color: #273244;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-input:focus {
  border-color: #8da2c0;
  box-shadow: 0 0 0 3px rgba(71, 105, 150, 0.08);
}

.filter-select {
  height: 43px;
  min-width: 145px;
  padding: 0 12px;
  border: 1px solid #dfe4ec;
  border-radius: 9px;
  background: #ffffff;
  color: #344054;
  outline: none;
  font-size: 13px;
}

/* GROUP LIST */

.groups-container {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.group-card {
  background: #ffffff;
  border: 1px solid #e3e7ef;
  border-radius: 12px;
  overflow: hidden;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.group-card:hover {
  border-color: #ccd4e1;
  box-shadow: 0 5px 18px rgba(31, 45, 61, 0.06);
}

/* GROUP HEADER */

.group-header {
  min-height: 76px;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 220px 1fr auto;
  align-items: center;
  gap: 20px;
  cursor: pointer;
}

.group-info {
  display: flex;
  align-items: center;
  gap: 13px;
}

.expand-button {
  width: 30px;
  height: 30px;
  border: 1px solid #e0e5ed;
  border-radius: 7px;
  background: #f8f9fb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 12px;
  transition: all 0.2s ease;
}

.group-card.expanded .expand-button {
  background: #edf2f8;
  color: #31445f;
}

.group-id-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.group-label {
  font-size: 11px;
  color: #98a2b3;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.group-id {
  font-size: 16px;
  font-weight: 700;
  color: #1d2939;
}

/* LAST TRANSACTION */

.last-transaction {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.transaction-event {
  padding: 5px 9px;
  border-radius: 6px;
  background: #f1f4f8;
  color: #475467;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.transaction-main {
  min-width: 0;
}

.transaction-id {
  font-size: 13px;
  font-weight: 600;
  color: #344054;
}

.transaction-meta {
  margin-top: 4px;
  display: flex;
  gap: 12px;
  color: #8a94a6;
  font-size: 11px;
}

.transaction-meta span {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* GROUP STATUS */

.group-status {
  display: flex;
  align-items: center;
  gap: 18px;
  justify-content: flex-end;
}

.transaction-count {
  color: #7a8497;
  font-size: 12px;
  white-space: nowrap;
}

.error-count {
  min-width: 62px;
  text-align: center;
  padding: 6px 10px;
  border-radius: 7px;
  background: #fff1f1;
  color: #d04444;
  font-size: 11px;
  font-weight: 700;
}

.error-count.no-error {
  background: #edf9f4;
  color: #16855b;
}

/* EXPANDED DATA */

.group-details {
  border-top: 1px solid #edf0f4;
  background: #fafbfd;
  padding: 15px 20px 18px;
}

.details-header {
  display: grid;
  grid-template-columns: 110px 95px 80px 1fr 140px 120px 90px;
  gap: 12px;
  padding: 0 14px 9px;
  color: #98a2b3;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.45px;
}

.transaction-row {
  display: grid;
  grid-template-columns: 110px 95px 80px 1fr 140px 120px 90px;
  gap: 12px;
  align-items: center;
  min-height: 56px;
  padding: 8px 14px;
  background: #ffffff;
  border: 1px solid #e8ebf1;
  border-radius: 9px;
  margin-bottom: 7px;
  cursor: pointer;
  transition: all 0.18s ease;
}

.transaction-row:hover {
  border-color: #bdc8d8;
  box-shadow: 0 3px 10px rgba(31, 45, 61, 0.05);
  transform: translateY(-1px);
}

/* ERROR ROW */

.transaction-row.error-row {
  background: #fff8f8;
  border-color: #f1cccc;
}

.transaction-row.error-row:hover {
  border-color: #e8aaaa;
}

.transaction-row.error-row .row-id {
  color: #c03939;
}

.row-event {
  font-size: 11px;
  font-weight: 700;
  color: #475467;
}

.row-id {
  font-size: 12px;
  font-weight: 600;
  color: #344054;
}

.row-status {
  display: inline-flex;
  width: fit-content;
  padding: 5px 9px;
  border-radius: 5px;
  background: #eaf8f2;
  color: #16855b;
  font-size: 10px;
  font-weight: 800;
}

.row-status.error {
  background: #ffe9e9;
  color: #ce3c3c;
}

.row-value {
  font-size: 11px;
  color: #667085;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-value strong {
  color: #344054;
  font-weight: 600;
}

.row-arrow {
  text-align: right;
  color: #98a2b3;
  font-size: 13px;
}

.transaction-row:hover .row-arrow {
  color: #344054;
}

/* ERROR MESSAGE */

.error-message {
  margin-top: 6px;
  padding: 9px 12px;
  background: #fff0f0;
  border-left: 3px solid #d14343;
  border-radius: 5px;
  color: #b93838;
  font-size: 11px;
  line-height: 1.5;
}

/* DETAIL PANEL */

.detail-panel {
  background: #ffffff;
  border: 1px solid #e1e6ee;
  border-radius: 14px;
  padding: 22px;
  margin-top: 18px;
  box-shadow: 0 5px 20px rgba(31, 45, 61, 0.06);
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18px;
  border-bottom: 1px solid #edf0f4;
}

.detail-title {
  display: flex;
  align-items: center;
  gap: 12px;
}

.detail-title h2 {
  margin: 0;
  font-size: 18px;
  color: #1d2939;
}

.detail-title p {
  margin: 4px 0 0;
  color: #98a2b3;
  font-size: 11px;
}

.close-button {
  width: 34px;
  height: 34px;
  border: 1px solid #e0e5ec;
  background: #ffffff;
  border-radius: 7px;
  color: #667085;
  cursor: pointer;
  font-size: 14px;
}

.close-button:hover {
  background: #f7f8fa;
  color: #344054;
}

/* DETAIL GRID */

.detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px 22px;
  padding-top: 20px;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.detail-label {
  color: #98a2b3;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 700;
}

.detail-value {
  color: #344054;
  font-size: 13px;
  font-weight: 600;
  word-break: break-word;
}

/* STATUS BADGES */

.status-success {
  display: inline-flex;
  width: fit-content;
  padding: 5px 10px;
  border-radius: 6px;
  background: #eaf8f2;
  color: #16855b;
  font-size: 11px;
  font-weight: 700;
}

.status-error {
  display: inline-flex;
  width: fit-content;
  padding: 5px 10px;
  border-radius: 6px;
  background: #ffeaea;
  color: #cf3e3e;
  font-size: 11px;
  font-weight: 700;
}

/* EMPTY */

.empty-state {
  background: #ffffff;
  border: 1px dashed #d9dfe8;
  border-radius: 12px;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a94a6;
}

.empty-state-icon {
  font-size: 28px;
  margin-bottom: 10px;
}

.empty-state h3 {
  margin: 0;
  color: #475467;
  font-size: 15px;
}

.empty-state p {
  margin: 5px 0 0;
  font-size: 12px;
}

/* LOADING */

.loading-container {
  min-height: 250px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 30px;
  height: 30px;
  border: 3px solid #e5e9f0;
  border-top-color: #536b8a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* RESPONSIVE */

@media (max-width: 1100px) {
  .summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .group-header {
    grid-template-columns: 180px 1fr auto;
  }

  .details-header,
  .transaction-row {
    grid-template-columns: 90px 80px 70px 1fr 110px 100px 60px;
  }
}

@media (max-width: 800px) {
  .dashboard {
    padding: 18px;
  }

  .page-header {
    align-items: flex-start;
    gap: 15px;
  }

  .summary-grid {
    grid-template-columns: 1fr 1fr;
  }

  .toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .search-wrapper {
    max-width: none;
  }

  .group-header {
    grid-template-columns: 1fr auto;
    gap: 10px;
    padding: 14px;
  }

  .last-transaction {
    grid-column: 1 / -1;
    padding-left: 43px;
  }

  .group-status {
    grid-column: 2;
    grid-row: 1;
  }

  .details-header {
    display: none;
  }

  .transaction-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding: 13px;
  }

  .row-event,
  .row-id,
  .row-status,
  .row-value {
    min-width: calc(50% - 10px);
  }

  .row-arrow {
    margin-left: auto;
  }

  .detail-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 520px) {
  .dashboard {
    padding: 14px;
  }

  .header-left h1 {
    font-size: 21px;
  }

  .summary-grid {
    grid-template-columns: 1fr;
  }

  .group-status {
    gap: 7px;
  }

  .transaction-count {
    display: none;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }
}
